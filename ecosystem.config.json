{
  "apps": [{
    "name": "todo-app",
    "script": "app.js",
    "cwd": "/www/wwwroot/todo",
    "exec_mode": "fork",
    "instances": 1,
    "autorestart": true,
    "watch": false,
    "max_memory_restart": "1G",
    "error_file": "/www/wwwroot/todo/logs/err.log",
    "out_file": "/www/wwwroot/todo/logs/out.log",
    "log_date_format": "YYYY-MM-DD HH:mm:ss"
  }]
}
