<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_bg">

    <!-- Date header -->
    <TextView
        android:id="@+id/widget_date_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#1C1C1E"
        android:layout_marginBottom="4dp"
        android:text="--" />

    <!-- Task Row 0 -->
    <LinearLayout
        android:id="@+id/task_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <ImageView android:id="@+id/task_dot_0"
            android:layout_width="7dp" android:layout_height="7dp"
            android:src="@drawable/dot_gray" />

        <TextView android:id="@+id/task_time_0"
            android:layout_width="34dp" android:layout_height="wrap_content"
            android:textSize="10sp" android:textColor="#8E8E93"
            android:layout_marginStart="5dp" />

        <TextView android:id="@+id/task_title_0"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp" android:textColor="#1C1C1E"
            android:layout_marginStart="5dp"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>

    <!-- Task Row 1 -->
    <LinearLayout
        android:id="@+id/task_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <ImageView android:id="@+id/task_dot_1"
            android:layout_width="7dp" android:layout_height="7dp"
            android:src="@drawable/dot_gray" />

        <TextView android:id="@+id/task_time_1"
            android:layout_width="34dp" android:layout_height="wrap_content"
            android:textSize="10sp" android:textColor="#8E8E93"
            android:layout_marginStart="5dp" />

        <TextView android:id="@+id/task_title_1"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp" android:textColor="#1C1C1E"
            android:layout_marginStart="5dp"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>

    <!-- Task Row 2 -->
    <LinearLayout
        android:id="@+id/task_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <ImageView android:id="@+id/task_dot_2"
            android:layout_width="7dp" android:layout_height="7dp"
            android:src="@drawable/dot_gray" />

        <TextView android:id="@+id/task_time_2"
            android:layout_width="34dp" android:layout_height="wrap_content"
            android:textSize="10sp" android:textColor="#8E8E93"
            android:layout_marginStart="5dp" />

        <TextView android:id="@+id/task_title_2"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp" android:textColor="#1C1C1E"
            android:layout_marginStart="5dp"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>

    <!-- Task Row 3 -->
    <LinearLayout
        android:id="@+id/task_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <ImageView android:id="@+id/task_dot_3"
            android:layout_width="7dp" android:layout_height="7dp"
            android:src="@drawable/dot_gray" />

        <TextView android:id="@+id/task_time_3"
            android:layout_width="34dp" android:layout_height="wrap_content"
            android:textSize="10sp" android:textColor="#8E8E93"
            android:layout_marginStart="5dp" />

        <TextView android:id="@+id/task_title_3"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp" android:textColor="#1C1C1E"
            android:layout_marginStart="5dp"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>

    <!-- Task Row 4 -->
    <LinearLayout
        android:id="@+id/task_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <ImageView android:id="@+id/task_dot_4"
            android:layout_width="7dp" android:layout_height="7dp"
            android:src="@drawable/dot_gray" />

        <TextView android:id="@+id/task_time_4"
            android:layout_width="34dp" android:layout_height="wrap_content"
            android:textSize="10sp" android:textColor="#8E8E93"
            android:layout_marginStart="5dp" />

        <TextView android:id="@+id/task_title_4"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp" android:textColor="#1C1C1E"
            android:layout_marginStart="5dp"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>

    <!-- Task Row 5 -->
    <LinearLayout
        android:id="@+id/task_row_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <ImageView android:id="@+id/task_dot_5"
            android:layout_width="7dp" android:layout_height="7dp"
            android:src="@drawable/dot_gray" />

        <TextView android:id="@+id/task_time_5"
            android:layout_width="34dp" android:layout_height="wrap_content"
            android:textSize="10sp" android:textColor="#8E8E93"
            android:layout_marginStart="5dp" />

        <TextView android:id="@+id/task_title_5"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp" android:textColor="#1C1C1E"
            android:layout_marginStart="5dp"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>

    <!-- Task Row 6 -->
    <LinearLayout
        android:id="@+id/task_row_6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <ImageView android:id="@+id/task_dot_6"
            android:layout_width="7dp" android:layout_height="7dp"
            android:src="@drawable/dot_gray" />

        <TextView android:id="@+id/task_time_6"
            android:layout_width="34dp" android:layout_height="wrap_content"
            android:textSize="10sp" android:textColor="#8E8E93"
            android:layout_marginStart="5dp" />

        <TextView android:id="@+id/task_title_6"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp" android:textColor="#1C1C1E"
            android:layout_marginStart="5dp"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>

    <!-- Overflow indicator: "+N more" shown when tasks exceed max visible rows -->
    <TextView
        android:id="@+id/widget_overflow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#8E8E93"
        android:textStyle="italic"
        android:gravity="center"
        android:layout_marginTop="2dp"
        android:visibility="gone"
        android:text="还有 3 项..." />
</LinearLayout>
