# 服务器配置
PORT=3000

# MySQL数据库配置（便签墙）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=wallnotepad

# DeepSeek API Key（AI 日程助手）
# 请在 DeepSeek 官网获取: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key

# 前端允许的域名（用于CORS，逗号分隔）
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# JWT 密钥（请替换为随机字符串）
JWT_SECRET=change-this-to-a-random-string

# 管理员默认密码（首次启动自动创建 admin 用户）
ADMIN_PASSWORD=admin123

# Token 有效期
TOKEN_EXPIRY=30d

# MySQL数据库配置（常用网站书签）
COMMON_SITES_DB_HOST=localhost
COMMON_SITES_DB_PORT=3306
COMMON_SITES_DB_USER=todo
COMMON_SITES_DB_PASSWORD=your_password
COMMON_SITES_DB_NAME=todo
